{
  "name": "ccgui-plugin-balance-meter",
  "version": "0.1.0",
  "private": true,
  "description": "CC GUI 插件：按实际路由网关识别供应商与计费方式，查询 API 余额 / 订阅余量",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "vite build",
    "validate": "node scripts/validate-manifest.mjs",
    "validate:dist": "node scripts/validate-manifest.mjs --dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
